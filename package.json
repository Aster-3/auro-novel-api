{
  "name": "auro-novel-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build",
    "dev": "nodemon --legacy-watch --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migration:generate": "node scripts/generate-migration.mjs",
    "migration:run:dev": "typeorm-ts-node-esm migration:run -d src/database/data-source.ts",
    "migration:show:dev": "typeorm-ts-node-esm migration:show -d src/database/data-source.ts",
    "migration:revert:dev": "typeorm-ts-node-esm migration:revert -d src/database/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "migration:show:prod": "typeorm migration:show -d dist/database/data-source.js",
    "migration:revert:prod": "typeorm migration:revert -d dist/database/data-source.js",
    "seed:dev": "tsx src/database/run.seeders.ts",
    "seed:prod": "node dist/database/run.seeders.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aster-3/auro-novel-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Aster-3/auro-novel-api/issues"
  },
  "homepage": "https://github.com/Aster-3/auro-novel-api#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@plunk/node": "^3.0.3",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "slugify": "^1.6.6",
    "truncate-html": "^1.2.2",
    "typeorm": "^0.3.28",
    "typeorm-extension": "^3.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
